SECRET_KEY=changez-cette-cle-en-production
DEBUG=False
ALLOWED_HOSTS=votre-domaine.com

# Base de données. Laisser DB_NAME VIDE : dev comme prod tournent sur SQLite.
# Le PostgreSQL d'o2switch est en 9.6, Django 6.0 exige 14+ — le renseigner
# ferait échouer toutes les requêtes. Voir docs/deploiement-production.md.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Emails (réinitialisation de mot de passe). Sans EMAIL_HOST, les emails sont
# affichés dans la console au lieu d'être envoyés. o2switch : boîte créée dans
# cPanel → Comptes de messagerie ; serveur et port dans « Connect Devices »
# (465 = SSL, 587 = STARTTLS). Voir docs/deploiement-production.md §10.
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Facultatif : par défaut « Easybiodiv <EMAIL_HOST_USER> ».
DEFAULT_FROM_EMAIL=
# Adresse publiée dans les mentions légales ; par défaut EMAIL_HOST_USER.
CONTACT_EMAIL=
